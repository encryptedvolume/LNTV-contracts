METADATA_URI=https://metadata.example/REPLACE_WITH_COLLECTION/
# The base must end in /. IDs 1–100 resolve to <base><id>.json.
# Initial auction end is START_TIME + 48 hours; rolling ten-minute extensions are uncapped.
# Use an RPC environment variable and Foundry keystore/hardware wallet; no private key belongs in this file.
# Refunds stay available until the payout wallet successfully recovers remaining ETH.
# Recovery is optional after settlement and final extended end + 28 days; success closes refunds.
